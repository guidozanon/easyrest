# Configuración del servidor de sync. Copiá este archivo a .env y completalo.
# Ver docs/SYNC.md para el detalle de cada valor.

# Obligatoria. Cifra los secretos de todos los workspaces: si la perdés, no se recuperan.
#   openssl rand -base64 32
EASYREST_MASTER_KEY=

# URL pública del server. Tiene que ser la misma con la que registrás el redirect en el IdP,
# que es <EASYREST_PUBLIC_URL>/api/v1/auth/callback
EASYREST_PUBLIC_URL=http://localhost:8080
EASYREST_PORT=8080

# IdP por OIDC: Google, Microsoft Entra, Okta, Auth0, Keycloak, Authentik…
#   Google:    https://accounts.google.com
#   Entra:     https://login.microsoftonline.com/<tenant-id>/v2.0
#   Keycloak:  https://keycloak.tuempresa.com/realms/<realm>
OIDC_ID=google
OIDC_NAME=Google
OIDC_AUTHORITY=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# La consola web de administración vive en /Admin. Poné false para exponer sólo la API.
#   Admin__Enabled=false

# Administradores del server. Si queda vacío, el primero que entra queda como admin.
# Se aplica en cada login: agregar un mail acá es la forma de recuperar el acceso.
#   Auth__ServerAdminEmails__0=vos@tuempresa.com

# GitHub (descomentá el provider 1 en docker-compose.yml para usarlo)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sólo si usás Postgres
DB_PASSWORD=
