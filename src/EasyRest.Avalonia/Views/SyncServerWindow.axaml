<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EasyRest.Avalonia.Views.SyncServerWindow"
        Title="Servidor de sync" Width="620" Height="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="avares://EasyRest/Assets/easyrest.ico"
        Background="#1E1E2E">
    <DockPanel Margin="18">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,14,0,0">
            <TextBlock x:Name="Estado" VerticalAlignment="Center" FontSize="11"
                       Foreground="#6C7086" TextWrapping="Wrap" MaxWidth="380"/>
            <Button Content="Cerrar" Click="Close_Click"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Spacing="0">
            <TextBlock Text="SERVIDOR" FontSize="11" FontWeight="Bold" Foreground="#6C7086"/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#6C7086" Margin="0,4,0,8"
                       Text="El servidor de sync de tu organización. Reemplaza a git para este workspace: las colecciones y los ambientes viajan por ahí, con los secretos cifrados. Cada empresa corre el suyo."/>

            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
                <TextBox x:Name="ServerUrl" Grid.Column="0" Watermark="https://sync.tu-empresa.com"
                         FontFamily="Consolas,Menlo,monospace"/>
                <Button x:Name="ConectarBtn" Grid.Column="1" Content="Conectar" Margin="8,0,0,0"
                        Click="Conectar_Click"/>
                <Button x:Name="SalirBtn" Grid.Column="2" Content="Cerrar sesión" Margin="8,0,0,0"
                        IsVisible="False" Click="CerrarSesion_Click"/>
            </Grid>

            <StackPanel x:Name="ProveedoresPanel" IsVisible="False" Margin="0,0,0,10" Spacing="6">
                <TextBlock Text="Iniciá sesión con:" FontSize="11" Foreground="#6C7086"/>
                <ItemsControl x:Name="Proveedores">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <Border x:Name="SesionPanel" IsVisible="False" Background="#272739" CornerRadius="6"
                    Padding="10" Margin="0,0,0,12">
                <TextBlock x:Name="SesionTexto" FontSize="12" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <Grid x:Name="WorkspacesPanel" IsVisible="False" RowDefinitions="Auto,*,Auto,Auto,*,Auto">

            <TextBlock Grid.Row="0" Text="WORKSPACE REMOTO" FontSize="11" FontWeight="Bold"
                       Foreground="#6C7086" Margin="0,0,0,6"/>

            <ListBox x:Name="Workspaces" Grid.Row="1" MinHeight="110"
                     SelectionChanged="Workspaces_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock FontSize="11" Foreground="#6C7086"
                                       Text="{Binding Detalle}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button x:Name="UsarBtn" Content="Usar en este workspace" Click="Usar_Click"
                        IsEnabled="False"/>
                <Button Content="Crear…" Click="Crear_Click"/>
                <Button Content="Aceptar invitación…" Click="Aceptar_Click"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Text="MIEMBROS" FontSize="11" FontWeight="Bold"
                       Foreground="#6C7086" Margin="0,16,0,6"/>

            <ListBox x:Name="Miembros" Grid.Row="4" MinHeight="110"
                     SelectionChanged="Miembros_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"/>
                            <TextBlock FontSize="11" Foreground="#6C7086" Text="{Binding Detalle}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Content="Invitar…" Click="Invitar_Click"/>
                <Button x:Name="RolBtn" Content="Cambiar rol…" Click="Rol_Click" IsEnabled="False"/>
                <Button x:Name="QuitarBtn" Content="Quitar" Click="Quitar_Click" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
