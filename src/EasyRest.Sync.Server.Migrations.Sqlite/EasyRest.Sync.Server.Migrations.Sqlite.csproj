<Project Sdk="Microsoft.NET.Sdk">

  <!-- Migraciones para SQLite: el proveedor por defecto, y el que instala el instalador.
       Para regenerarlas, ver docs/SYNC.md (sección "Cambiar el esquema"). -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EasyRest.Sync.Server.Migrations.Sqlite</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasyRest.Sync.Data\EasyRest.Sync.Data.csproj" />
  </ItemGroup>

</Project>
