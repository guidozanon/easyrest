<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike: head de Android sobre el mismo Core, para responder si vale la pena el móvil.
       No referencia a EasyRest.Avalonia a propósito — esa app arrastra Avalonia.Desktop y una
       UI pensada para mouse y teclado. Acá lo que se prueba es el Core.

       Avalonia va en 11.2 (la primera versión donde mobile quedó estable) mientras el escritorio
       sigue en 11.1.3: es un spike y no tiene por qué mover la versión de la app. Si el móvil
       avanza, lo primero es unificar.

       Necesita el workload de Android:  dotnet workload install android -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- La versión de la plataforma va explícita: sin ella, SupportedOSPlatformVersion termina
         fijando también la de compilación y el restore falla, porque Avalonia.Android pide
         net8.0-android34.0. Acá el 34 es contra qué se compila y el 21 el mínimo para correr. -->
    <TargetFramework>net8.0-android34.0</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <!-- El SDK avisa que net8.0-android está fuera de soporte y lo trata como error. Es un spike
         sobre un repo que hoy es todo net8.0; migrar la app entera no entra en esta pregunta. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EasyRest.Android</RootNamespace>
    <ApplicationId>com.rentlysoft.easyrest</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Android" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasyRest.Core\EasyRest.Core.csproj" />
  </ItemGroup>

</Project>
