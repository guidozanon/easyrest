<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike: head de Android sobre el mismo Core, para responder si vale la pena el móvil.
       No referencia a EasyRest.Avalonia a propósito — esa app arrastra Avalonia.Desktop y una
       UI pensada para mouse y teclado. Acá lo que se prueba es el Core.

       Avalonia va en 11.2 (la primera versión donde mobile quedó estable) mientras el escritorio
       sigue en 11.1.3: es un spike y no tiene por qué mover la versión de la app. Si el móvil
       avanza, lo primero es unificar.

       Necesita el workload de Android:  dotnet workload install android -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- La versión de la plataforma va explícita: sin ella, SupportedOSPlatformVersion termina
         fijando también la de compilación y el restore falla, porque Avalonia.Android pide
         net8.0-android34.0. Acá el 34 es contra qué se compila y el 21 el mínimo para correr. -->
    <TargetFramework>net8.0-android34.0</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <!-- El SDK avisa que net8.0-android está fuera de soporte y lo trata como error. Es un spike
         sobre un repo que hoy es todo net8.0; migrar la app entera no entra en esta pregunta. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EasyRest.Android</RootNamespace>
    <ApplicationId>com.rentlysoft.easyrest</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <!-- Apagar el linker acá rompe el build de una forma silenciosa: el compilador de XAML de
         Avalonia reescribe el assembly de la app en obj/…/Avalonia/, y sin el paso del linker
         el SDK de Android pierde ese rastro — EasyRest.Android.dll no entra en los assets del
         APK ni en la lista que escanea GenerateJavaStubs, así que no se genera el wrapper de
         MainActivity y el APK sale sin ninguna actividad. Instala, no aparece en el cajón y el
         build termina con cero warnings.
         Así que va el trimming por defecto de Release. TrimMode=partial sólo toca assemblies
         marcados como recortables, o sea los del SDK: Jint y EasyRest.Core quedan enteros, que
         es justo lo que hace falta —lo que rompe la interop de Jint es que el trimmer le borre
         los miembros que resuelve por reflexión— y es la misma configuración que tests/aot-probe
         ya verificó. -->
    <TrimMode>partial</TrimMode>
    <!-- El AOT sí queda apagado: en el spike no aporta y agrega otra variable al problema. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Android" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasyRest.Core\EasyRest.Core.csproj" />
  </ItemGroup>

  <!-- Arreglo del bug que dejaba el APK sin actividades.

       Avalonia calcula dónde escribir el assembly con el XAML compilado así:

           <IntermediateAssembly Update="*"
               AvaloniaCompileOutput="%(RelativeDir)Avalonia\%(Filename)%(Extension)"/>

       o sea, relativo a dónde está el item *en ese momento*. Después InjectAvaloniaXamlOutput
       reemplaza el item por esa salida. En el build de Android eso ocurre dos veces, y la segunda
       vuelta calcula la ruta sobre un item que ya vive en Avalonia/, dando Avalonia/Avalonia/…,
       que no existe. El assembly de la app se cae del pipeline: no entra en los assets del APK ni
       en lo que escanea GenerateJavaStubs, y el APK sale sin MainActivity.

       Acá se vuelve a fijar la metadata a una ruta absoluta derivada de IntermediateOutputPath,
       que no depende de dónde esté el item. Con eso la segunda pasada apunta al mismo lugar que
       la primera en vez de anidar. Es un parche local: lo correcto sería que Avalonia la calcule
       de forma idempotente aguas arriba. -->
  <Target Name="_EasyRestFijarSalidaDeAvalonia" AfterTargets="PrepareToCompileAvaloniaXaml">
    <PropertyGroup>
      <_EasyRestAvaloniaDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)Avalonia'))</_EasyRestAvaloniaDir>
    </PropertyGroup>
    <ItemGroup>
      <IntermediateAssembly Update="*"
          AvaloniaCompileOutput="$(_EasyRestAvaloniaDir)/%(Filename)%(Extension)" />
      <IntermediateRefAssembly Update="*"
          AvaloniaCompileOutput="$(_EasyRestAvaloniaDir)/%(Filename)%(Extension)" />
      <_DebugSymbolsIntermediatePath Update="*"
          AvaloniaCompileOutput="$(_EasyRestAvaloniaDir)/%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
