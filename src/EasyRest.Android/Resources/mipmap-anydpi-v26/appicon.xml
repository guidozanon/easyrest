<?xml version="1.0" encoding="utf-8"?>
<!-- Desde Android 8 el lanzador recorta el ícono con la máscara que tenga configurada (círculo,
     squircle, etc.), así que las dos capas van separadas. Los PNG de mipmap-* siguen siendo los
     que usan las versiones anteriores. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/appicon_background" />
  <foreground android:drawable="@mipmap/appicon_foreground" />
</adaptive-icon>
