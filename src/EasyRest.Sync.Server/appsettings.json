{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=/data/easyrest-sync.db"
  },
  "Auth": {
    "PublicUrl": "http://localhost:8080",
    "AllowedRedirectSchemes": [ "easyrest" ],
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30,
    "AllowOpenRegistration": true,
    "AllowedEmailDomains": [],
    "Providers": []
  }
}
